# PHPStan for the module, run inside a Magento project (Magento classes and generated factories
# resolved by bitexpert/phpstan-magento). The Marketplace does not run PHPStan; this is our gate.
includes:
    - /var/www/html/vendor/bitexpert/phpstan-magento/extension.neon
parameters:
    level: 6
    phpVersion: 80100
    paths:
        - .
    excludePaths:
        - vendor/*
    magento:
        magentoRoot: /var/www/html
    # One config for PHPStan 1 (Magento 2.4.7 / 2.4.8) and PHPStan 2 (2.4.9):
    # - PHPStan 2 cannot parse PHPMD's @SuppressWarnings(PHPMD.Rule), the form Magento core uses;
    # - the tests carry both @dataProvider (PHPUnit 9) and #[DataProvider] (PHPUnit 10+); with
    #   PHPUnit 9 the attribute class does not exist.
    ignoreErrors:
        -
            identifier: phpDoc.parseError
            message: '#@SuppressWarnings#'
        -
            identifier: attribute.notFound
            message: '#PHPUnit\\Framework\\Attributes\\DataProvider#'
    reportUnmatchedIgnoredErrors: false
