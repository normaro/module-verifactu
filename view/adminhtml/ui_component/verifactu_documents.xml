<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">verifactu_documents.verifactu_documents_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>verifactu_document_columns</spinner>
        <deps>
            <dep>verifactu_documents.verifactu_documents_data_source</dep>
        </deps>
    </settings>
    <dataSource name="verifactu_documents_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Normaro_Verifactu::documents</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="verifactu_documents_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <massaction name="listing_massaction">
            <action name="resend">
                <settings>
                    <url path="verifactu/document/massResend"/>
                    <type>resend</type>
                    <label translate="true">Resend</label>
                    <confirm>
                        <message translate="true">Resend the selected documents?</message>
                        <title translate="true">Resend</title>
                    </confirm>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="verifactu_document_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="source_type" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="Normaro\Verifactu\Model\Config\Source\SourceType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Magento document</label>
            </settings>
        </column>
        <column name="source_increment_id" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Magento number</label>
            </settings>
        </column>
        <column name="processor_id" sortOrder="35">
            <settings>
                <filter>text</filter>
                <label translate="true">Sent as (processor ID)</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="number" sortOrder="40">
            <settings>
                <filter>text</filter>
                <fieldClass>
                    <class name="verifactu-nowrap">true</class>
                </fieldClass>
                <label translate="true">Invoice number</label>
            </settings>
        </column>
        <column name="type" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Normaro\Verifactu\Model\Config\Source\DocumentType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Normaro\Verifactu\Model\Config\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="aeat_status" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Normaro\Verifactu\Model\Config\Source\AeatState"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">AEAT</label>
            </settings>
        </column>
        <column name="issue_date" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <dateFormat>MMM d, y</dateFormat>
                <timezone>false</timezone>
                <fieldClass>
                    <class name="verifactu-nowrap">true</class>
                </fieldClass>
                <label translate="true">Issue date</label>
            </settings>
        </column>
        <column name="attempts" sortOrder="90">
            <settings>
                <label translate="true">Attempts</label>
            </settings>
        </column>
        <column name="last_error" sortOrder="100">
            <settings>
                <filter>text</filter>
                <label translate="true">Message</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="110">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
    </columns>
</listing>
