/** @var \Normaro\Verifactu\Block\Adminhtml\Document\Info $block */
/** @var \Magento\Framework\Escaper $escaper */
$document = $block->getDocument();
$notSent = __('Not sent to Quaderno (module disabled, not paid yet, or created before the module was installed).');
$link = static fn (string $url, $label): string => '<a href="' . $escaper->escapeUrl($url)
    . '" target="_blank" rel="noopener noreferrer">' . $escaper->escapeHtml($label) . '</a>';
?>
<section class="admin__page-section verifactu-document">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Verifactu')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <?php if ($document === null): ?>
            <p><?= $escaper->escapeHtml($notSent) ?></p>
        <?php else: ?>
            <?php
            $aeat = (string)$document->getData('aeat_status');
            $rows = [
                [__('Status'), $escaper->escapeHtml(__($block->getStatusLabel($document)))],
                [__('Invoice number'), $escaper->escapeHtml((string)$document->getData('number'))],
                [__('Type'), $escaper->escapeHtml($document->getData('type') ? __($document->getTypeLabel()) : '')],
                [__('AEAT'), $aeat === '' ? '' : '<span title="' . $escaper->escapeHtmlAttr($aeat) . '">'
                    . $escaper->escapeHtml(__($document->getAeatLabel())) . '</span>'],
                [__('Issue date'), $escaper->escapeHtml($block->getIssueDate($document))],
                [__('Verification'), $document->getData('aeat_qr_url')
                    ? $link((string)$document->getData('aeat_qr_url'), __('Verify at AEAT')) : ''],
                [__('Quaderno verification page'), $document->getProviderPageUrl() !== null
                    ? $link((string)$document->getProviderPageUrl(), __('View in Quaderno')) : ''],
                [__('PDF'), $document->getData('pdf_url')
                    ? $link((string)$document->getData('pdf_url'), __('Download PDF')) : ''],
                [__('Message'), $escaper->escapeHtml((string)$document->getData('last_error'))],
            ];
            ?>
            <table class="admin__table-secondary verifactu-document-table">
                <tbody>
                <?php foreach ($rows as [$label, $html]): ?>
                    <?php if ($html !== ''): ?>
                        <tr>
                            <th><?= $escaper->escapeHtml($label) ?></th>
                            <td><?= /* @noEscape */ $html ?></td>
                        </tr>
                    <?php endif; ?>
                <?php endforeach; ?>
                </tbody>
            </table>
            <?php if ($block->canResend($document)): ?>
                <form method="post" class="verifactu-document-resend"
                      action="<?= $escaper->escapeUrl($block->getResendUrl($document)) ?>">
                    <?= $block->getBlockHtml('formkey') ?>
                    <button type="submit" class="action-secondary">
                        <span><?= $escaper->escapeHtml(__('Resend to Quaderno')) ?></span>
                    </button>
                </form>
            <?php endif; ?>
        <?php endif; ?>
    </div>
</section>
