<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Child of the page form, not rendered by its template: Plugin\AdminDocumentBlockPosition puts it
             right after the "Invoice Information" section. -->
        <referenceBlock name="form">
            <block class="Normaro\Verifactu\Block\Adminhtml\Document\Info" name="verifactu.document.info"
                   template="Normaro_Verifactu::document/info.phtml">
                <arguments>
                    <argument name="source_type" xsi:type="string">invoice</argument>
                    <argument name="id_param" xsi:type="string">invoice_id</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
