/** @var \Normaro\Verifactu\Block\Order\Documents $block */
/** @var \Magento\Framework\Escaper $escaper */
$documents = $block->getDocuments();
?>
<?php if ($documents): ?>
    <div class="block block-order-verifactu">
        <div class="block-title"><strong><?= $escaper->escapeHtml(__('Invoices and credit notes')) ?></strong></div>
        <div class="block-content">
            <ul>
                <?php foreach ($documents as $document): ?>
                    <?php $links = [
                        [$document->getData('pdf_url'), __('PDF')],
                        [$document->getProviderPageUrl(), __('View invoice')],
                        [$document->getData('aeat_qr_url'), __('Verify at AEAT')],
                    ]; ?>
                    <li>
                        <?php if ($document->getData('type') === \Normaro\Verifactu\Model\Document::TYPE_CREDIT): ?>
                            <?= $escaper->escapeHtml(__('Credit note')) ?>
                        <?php endif; ?>
                        <?= $escaper->escapeHtml((string)$document->getData('number')) ?>
                        <?php if ($document->getData('issue_date')): ?>
                            (<?= $escaper->escapeHtml($block->getIssueDate($document)) ?>)
                        <?php endif; ?>
                        <?php foreach ($links as [$url, $label]): ?>
                            <?php if ($url): ?>
                                · <a href="<?= $escaper->escapeUrl((string)$url) ?>"
                                     target="_blank" rel="noopener noreferrer"><?= $escaper->escapeHtml($label) ?></a>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    </div>
<?php endif; ?>
