<?xml version="1.0"?>
<!-- PHPMD rules for the module (Marketplace does not run PHPMD; this is our gate). -->
<ruleset name="NormaroVerifactu"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Clean code, size, design, naming, unused code; Magento-style exceptions</description>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
    <rule ref="rulesets/design.xml">
        <!-- Magento DI: constructors legitimately take many dependencies -->
        <exclude name="CouplingBetweenObjects"/>
    </rule>
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties><property name="maximum" value="20"/></properties>
    </rule>
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>
    <rule ref="rulesets/cleancode.xml">
        <!-- Magento uses static factories / ObjectManager-free statics in places; else-blocks are fine -->
        <exclude name="StaticAccess"/>
        <exclude name="ElseExpression"/>
        <exclude name="MissingImport"/>
    </rule>
</ruleset>
