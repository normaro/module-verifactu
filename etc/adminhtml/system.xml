<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="verifactu" translate="label" type="text" sortOrder="900" showInDefault="1"
                 showInWebsite="1" showInStore="1">
            <label>Verifactu</label>
            <tab>sales</tab>
            <resource>Normaro_Verifactu::config</resource>
            <group id="email_notice" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <frontend_model>Normaro\Verifactu\Block\Adminhtml\System\Config\EmailNotice</frontend_model>
            </group>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>Provider (Quaderno)</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="environment" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Environment</label>
                    <source_model>Normaro\Verifactu\Model\Config\Source\Environment</source_model>
                    <comment>Sandbox only accepts a *.sandbox-quadernoapp.com API URL.</comment>
                </field>
                <field id="api_url" translate="label comment" type="text" sortOrder="30" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>API URL</label>
                    <comment>From Quaderno: Settings > API keys, e.g. https://ACCOUNT.quadernoapp.com/api/</comment>
                    <validate>validate-url</validate>
                </field>
                <field id="api_key" translate="label" type="obscure" sortOrder="40" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Private API key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="trigger" translate="label comment" type="select" sortOrder="50" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Send invoices</label>
                    <source_model>Normaro\Verifactu\Model\Config\Source\Trigger</source_model>
                    <comment>On capture: an invoice is sent when it is paid. Credit memos are always sent.</comment>
                </field>
                <field id="threshold" translate="label comment" type="text" sortOrder="60" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Simplified invoice limit, EUR incl. IVA</label>
                    <comment><![CDATA[Use the same amount as the receipt limit in Quaderno. Spanish orders
                        without a NIF from this amount are held until a NIF is added.]]></comment>
                    <validate>required-entry validate-number validate-greater-than-zero</validate>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="70" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Debug logging</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Yes: log every exchange with Quaderno in var/log/verifactu.log, for support.
                        No: errors and status changes only. The API key and tax IDs are never written.]]></comment>
                </field>
            </group>
            <group id="tax" translate="label" type="text" sortOrder="20" showInDefault="1"
                   showInWebsite="1" showInStore="1">
                <label>IVA mapping</label>
                <field id="mapping" translate="label comment" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Tax class to IVA</label>
                    <frontend_model>Normaro\Verifactu\Block\Adminhtml\System\Config\TaxMapping</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <comment><![CDATA[Every product tax class used in orders, and the shipping tax class, needs a row.
                        The rate is the Spanish IVA rate of the class; for 0 % destinations (Canarias,
                        Ceuta, Melilla, EU B2B, export) the rate Magento charged is sent.]]></comment>
                </field>
            </group>
            <group id="footer" sortOrder="1000" showInDefault="1" showInWebsite="1" showInStore="1">
                <frontend_model>Normaro\Verifactu\Block\Adminhtml\System\Config\Footer</frontend_model>
            </group>
        </section>
    </system>
</config>
